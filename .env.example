# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# Optional after manual-login storage-state exists — avoid typing password every start
ATERNOS_USER=your-aternos-username-or-email
ATERNOS_PASS=your-aternos-password

# Discord webhook (optional status mirror)
WEBHOOK_ID=
WEBHOOK_TOKEN=

# Adult role gate — REQUIRED (bot exits if both empty)
ADULT_ROLE_ID=
ADULT_ROLE_NAME=Adult

# !start cooldown per user per guild (ms). Default 5 minutes.
START_COOLDOWN_MS=300000

# Camoufox / session
CAMOUFOX_PROFILE_DIR=./camoufox-profile
STORAGE_STATE_DIR=./data
# 1 = true headless; unset defaults to virtual display on Linux for the start path
CAMOUFOX_HEADLESS=
# CAMOUFOX_OS=linux
AD_WAIT_MS=180000
MANUAL_LOGIN_MS=300000
